generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/@prisma/client-finanza"
}

datasource db {
  provider = "postgresql"
  url      = env("FINANZA_DATABASE_URL")
}

model User {
  id               String      @id
  name             String?
  email            String?     @unique
  plan             String      @default("FREE")
  emprendeAccess   Boolean     @default(false)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  sharedFund       SharedFund?
}

model SharedFund {
  id                  String       @id @default(cuid())
  name                String       @default("Nuestro Fondo Común")
  balance             Float        @default(0)
  monthlyBurnRate     Float        @default(0)
  totalSavings        Float        @default(0)
  partnerName         String       @default("Pareja")
  partnerContribution Float        @default(0)
  userId              String       @unique
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  movements           Movement[]
  user                User         @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Movement {
  id           String     @id @default(cuid())
  type         String
  description  String
  amount       Float
  date         DateTime   @default(now())
  installments Int        @default(1)
  category     String     @default("General")
  fundId       String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  fund         SharedFund @relation(fields: [fundId], references: [id], onDelete: Cascade)
}
